# github.com/hybridsakura/prism-go-panel 配置示例（所有项均为环境变量，可直接用于 docker -e）

# 监听地址与端口（21114 为 RustDesk API 默认端口）
HOST=0.0.0.0
PORT=21114

# 数据库：SQLite 文件路径；以 mysql:// 开头或包含 @tcp( 时使用 MySQL
# DB_URL=mysql://user:pass@tcp(127.0.0.1:3306)/rustdesk?charset=utf8mb4
DB_URL=./prism.db

# 是否开放网页自助注册（关闭后仅管理员可建号）
ALLOW_REGISTRATION=true

# 初始管理员（仅数据库为空时创建；之后请从后台修改密码）
ADMIN_USER=admin
ADMIN_PASS=change-me-please

# access_token 有效期（秒），心跳会自动续期
TOKEN_TTL_SECONDS=7200

# 设备在线判定阈值（秒）：超过该时间没有心跳/资产上报即视为离线
ONLINE_TIMEOUT_SECONDS=120

# 管理后台会话有效期（秒）
SESSION_TTL_SECONDS=43200

# 登录限速（次/分钟/IP），0 表示关闭
LOGIN_RATE_LIMIT=0

# Web 控制端（/webui）静态资源目录，不存在时该功能自动关闭
# 目录结构需与 Python 参考版一致：{module,js,assets,canvaskit@*,ogvjs-*}
WEBCLIENT_DIR=./webui-dist

# Web 控制端使用的 ID 服务器（多个用逗号分隔，留空取请求主机）
# ID_SERVER=yourdomain.com

# 日志级别：debug / info / warn / error（RUST_LOG 为兼容别名，LOG_LEVEL 优先）
LOG_LEVEL=info
